genrule(
    name = "StaConfig",
    srcs = [],
    outs = ["util/StaConfig.hh"],
    cmd = """echo -e '
    #define STA_VERSION "2.7.0"
    #define STA_GIT_SHA1 "f21d4a3878e2531e3af4930818d9b5968aad9416"
    #define SSTA 0
    #define ZLIB_FOUND' > \"$@\"
    """,
    visibility = ["//:__subpackages__"],
)

