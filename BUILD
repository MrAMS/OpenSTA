# Generate location header files for parsers that use custom location file names
# These files would normally be generated by bison, but rules_bison doesn't collect them
genrule(
    name = "location_headers",
    srcs = [
        "verilog/VerilogParse.yy",
        "liberty/LibertyParse.yy",
        "parasitics/SpefParse.yy",
        "sdf/SdfParse.yy",
        "power/SaifParse.yy",
    ],
    outs = [
        "verilog/VerilogLocation.hh",
        "liberty/LibertyLocation.hh",
        "parasitics/SpefLocation.hh",
        "sdf/SdfLocation.hh",
        "power/SaifLocation.hh",
    ],
    cmd = """
        # Use bison to generate location headers
        BISON=$$(which bison || echo "")
        if [ -z "$$BISON" ]; then
            echo "Error: bison not found in PATH" >&2
            exit 1
        fi

        # Save current directory
        ORIG_DIR=$$(pwd)

        # Create a temporary working directory
        WORKDIR=$$(mktemp -d)
        trap "rm -rf $$WORKDIR" EXIT

        # Generate VerilogLocation.hh
        cd $$WORKDIR
        $$BISON --language=c++ --defines=VerilogParse.h -o VerilogParse.cc $$ORIG_DIR/$(location verilog/VerilogParse.yy) 2>/dev/null
        if [ -f VerilogLocation.hh ]; then
            cp VerilogLocation.hh $$ORIG_DIR/$(location verilog/VerilogLocation.hh)
        else
            echo "Warning: Failed to generate VerilogLocation.hh" >&2
            echo '#include "location.hh"' > $$ORIG_DIR/$(location verilog/VerilogLocation.hh)
        fi
        rm -f VerilogParse.* VerilogLocation.hh

        # Generate LibertyLocation.hh
        $$BISON --language=c++ --defines=LibertyParse.h -o LibertyParse.cc $$ORIG_DIR/$(location liberty/LibertyParse.yy) 2>/dev/null
        if [ -f LibertyLocation.hh ]; then
            cp LibertyLocation.hh $$ORIG_DIR/$(location liberty/LibertyLocation.hh)
        else
            echo "Warning: Failed to generate LibertyLocation.hh" >&2
            echo '#include "location.hh"' > $$ORIG_DIR/$(location liberty/LibertyLocation.hh)
        fi
        rm -f LibertyParse.* LibertyLocation.hh

        # Generate SpefLocation.hh
        $$BISON --language=c++ --defines=SpefParse.h -o SpefParse.cc $$ORIG_DIR/$(location parasitics/SpefParse.yy) 2>/dev/null
        if [ -f SpefLocation.hh ]; then
            cp SpefLocation.hh $$ORIG_DIR/$(location parasitics/SpefLocation.hh)
        else
            echo "Warning: Failed to generate SpefLocation.hh" >&2
            echo '#include "location.hh"' > $$ORIG_DIR/$(location parasitics/SpefLocation.hh)
        fi
        rm -f SpefParse.* SpefLocation.hh

        # Generate SdfLocation.hh
        $$BISON --language=c++ --defines=SdfParse.h -o SdfParse.cc $$ORIG_DIR/$(location sdf/SdfParse.yy) 2>/dev/null
        if [ -f SdfLocation.hh ]; then
            cp SdfLocation.hh $$ORIG_DIR/$(location sdf/SdfLocation.hh)
        else
            echo "Warning: Failed to generate SdfLocation.hh" >&2
            echo '#include "location.hh"' > $$ORIG_DIR/$(location sdf/SdfLocation.hh)
        fi
        rm -f SdfParse.* SdfLocation.hh

        # Generate SaifLocation.hh
        $$BISON --language=c++ --defines=SaifParse.h -o SaifParse.cc $$ORIG_DIR/$(location power/SaifParse.yy) 2>/dev/null
        if [ -f SaifLocation.hh ]; then
            cp SaifLocation.hh $$ORIG_DIR/$(location power/SaifLocation.hh)
        else
            echo "Warning: Failed to generate SaifLocation.hh" >&2
            echo '#include "location.hh"' > $$ORIG_DIR/$(location power/SaifLocation.hh)
        fi
        rm -f SaifParse.* SaifLocation.hh
    """,
)

# Wrapper headers to make generated .h files available as .hh
genrule(
    name = "parser_hh_wrappers",
    outs = [
        "verilog/VerilogParse.hh",
        "liberty/LibExprParse.hh",
        "liberty/LibertyParse.hh",
        "parasitics/SpefParse.hh",
        "sdf/SdfParse.hh",
        "power/SaifParse.hh",
    ],
    cmd = """
        echo '#include "VerilogParse.h"' > $(location verilog/VerilogParse.hh)
        echo '#include "LibExprParse.h"' > $(location liberty/LibExprParse.hh)
        echo '#include "LibertyParser.h"' > $(location liberty/LibertyParse.hh)
        echo '#include "SpefParser.h"' > $(location parasitics/SpefParse.hh)
        echo '#include "SdfParser.h"' > $(location sdf/SdfParse.hh)
        echo '#include "SaifParser.h"' > $(location power/SaifParse.hh)
    """,
)

# Header-only library to provide includes for flex/bison generated code
cc_library(
    name = "sta_headers",
    hdrs = glob([
        "dcalc/*.hh",
        "liberty/*.hh",
        "parasitics/*.hh",
        "power/*.hh",
        "sdc/*.hh",
        "sdf/*.hh",
        "search/*.hh",
        "spice/*.hh",
        "util/*.hh",
        # verilog/*.hh excluded due to VerilogScanner.hh including generated files
        "include/sta/*.hh",
    ]) + [
        ":StaConfig",  # Generated config header
        ":parser_hh_wrappers",  # Wrapper headers for .h -> .hh
        ":location_headers",  # Location headers for bison parsers
    ],
    includes = [
        ".",
        "include",
        "include/sta",
        "util",  # For StaConfig.hh
        "verilog",  # For generated VerilogParse.hh
        "liberty",  # For generated LibExprParse.hh and LibertyParse.hh
        "parasitics",  # For generated SpefParse.hh
        "sdf",  # For generated SdfParse.hh
        "power",  # For generated SaifParse.hh
    ],
    deps = [
        "@rules_flex//flex:current_flex_toolchain",  # Provides FlexLexer.h for scanner headers
    ],
)

flex_cc_library(
    name = "LibExprLex",
    src = "liberty/LibExprLex.ll",
    flex_options = ["-P", "LibExprLex_"],
    deps = [
        ":sta_headers",
        ":LibExprParse",  # Needs LibExprParse.hh
    ],
)

bison_cc_library(
    name = "LibExprParse",
    src = "liberty/LibExprParse.yy",
    bison_options = ["-p", "LibExprParse_", "-S", "lalr1.cc"],
    deps = [":sta_headers"],
)

